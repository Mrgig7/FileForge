describe('RBAC Config', () => {
  const rbac = require('../config/rbac');

  describe('Plan Limits', () => {
    it('should define limits for all roles', () => {
      const roles = ['USER', 'PRO', 'TEAM', 'ENTERPRISE', 'ADMIN'];

      for (const role of roles) {
        expect(rbac.getLimit(role, 'maxFileSize')).toBeDefined();
        expect(rbac.getLimit(role, 'maxTotalStorage')).toBeDefined();
      }
    });

    it('should have increasing limits for higher tiers', () => {
      const userLimit = rbac.getLimit('USER', 'maxFileSize');
      const proLimit = rbac.getLimit('PRO', 'maxFileSize');
      const teamLimit = rbac.getLimit('TEAM', 'maxFileSize');

      expect(proLimit).toBeGreaterThan(userLimit);
      expect(teamLimit).toBeGreaterThan(proLimit);
    });

    it('should have unlimited for ADMIN', () => {
      expect(rbac.getLimit('ADMIN', 'maxFileSize')).toBe(Infinity);
      expect(rbac.getLimit('ADMIN', 'maxTotalStorage')).toBe(Infinity);
    });
  });
});

