const request = require('supertest');

describe('Health Endpoints', () => {
  const baseUrl = process.env.TEST_API_URL || 'http://localhost:3000';

  describe('GET /health', () => {
    it('should return basic health status', async () => {
      const res = await request(baseUrl).get('/health');
      expect(res.status).toBe(200);
      expect(res.body.status).toBe('ok');
      expect(res.body.version).toBeDefined();
    });
  });

  describe('GET /health/deps', () => {
    it('should check all dependencies', async () => {
      const res = await request(baseUrl).get('/health/deps');
      expect(res.status).toBe(200);
      expect(res.body.database).toBeDefined();
      expect(res.body.redis).toBeDefined();
      expect(res.body.storage).toBeDefined();
    });
  });

  describe('GET /health/metrics', () => {
    it('should return metrics', async () => {
      const res = await request(baseUrl).get('/health/metrics');
      expect(res.status).toBe(200);
      expect(res.body.memory).toBeDefined();
      expect(res.body.uptime).toBeDefined();
    });
  });
});

describe('Scanner Service', () => {
  const { MockScanner, ScanResult } = require('../services/scannerService');

  describe('MockScanner', () => {
    it('should return clean for normal files', async () => {
      const scanner = new MockScanner();
      const result = await scanner.scanFile('test.pdf', Buffer.from('normal content'));

      expect(result.isClean).toBe(true);
      expect(result.status).toBe(ScanResult.CLEAN);
    });

    it('should detect EICAR test pattern in filename', async () => {
      const scanner = new MockScanner();
      const result = await scanner.scanFile('eicar.com', Buffer.from('test'));

      expect(result.isClean).toBe(false);
      expect(result.status).toBe(ScanResult.INFECTED);
      expect(result.threatName).toBeDefined();
    });

    it('should detect EICAR signature in content', async () => {
      const scanner = new MockScanner();
      const eicarString = 'X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*';
      const result = await scanner.scanFile('test.txt', Buffer.from(eicarString));

      expect(result.isClean).toBe(false);
      expect(result.status).toBe(ScanResult.INFECTED);
    });

    it('should report as available', async () => {
      const scanner = new MockScanner();
      expect(await scanner.isAvailable()).toBe(true);
    });
  });
});

describe('Queue System', () => {
  let mockQueue;

  beforeAll(() => {
    jest.mock('bullmq', () => ({
      Queue: jest.fn().mockImplementation(() => ({
        add: jest.fn().mockResolvedValue({ id: 'mock-job-id' }),
        on: jest.fn(),
        close: jest.fn().mockResolvedValue()
      })),
      Worker: jest.fn(),
      QueueScheduler: jest.fn()
    }), { virtual: true });

    jest.resetModules();
    mockQueue = require('../config/queue');
  });

  afterAll(async () => {
    if (mockQueue && mockQueue.closeQueues) {
      await mockQueue.closeQueues();
    }
  });

  describe('Job Creation', () => {
    it('should create post-upload job', async () => {
      try {
        const job = await mockQueue.addPostUploadJob('test-file-id-123');
        expect(job).toBeDefined();
        expect(job.id).toBeDefined();
      } catch (err) {
        if (err.message.includes('Redis') || err.message.includes('ECONNREFUSED')) {
          console.log('Skipping: Redis not available');
        } else {
          throw err;
        }
      }
    });
  });
});

